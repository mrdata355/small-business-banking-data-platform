FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jre-headless curl && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
WORKDIR /app
COPY pyproject.toml README.md requirements-full.txt ./
COPY src ./src
RUN pip install --no-cache-dir -e . && pip install --no-cache-dir -r requirements-full.txt
ENV PYTHONPATH=/app/src
CMD ["python", "-m", "oakbridge.jobs.kafka_lakehouse_stream"]
